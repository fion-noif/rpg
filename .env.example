# From your app at https://developer.intuit.com (Dashboard → your app → Keys & credentials)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# Must exactly match a redirect URI registered on the Intuit app
QBO_REDIRECT_URI=http://localhost:8355/callback

# sandbox | production
QBO_ENVIRONMENT=sandbox

# Postgres (docker compose default; see docker-compose.yml)
DATABASE_URL=postgres://racing:racing@localhost:5433/racing

# Base URL used in worker magic links printed by `npm run seed`
APP_BASE_URL=http://localhost:3000

# Manager password for /admin/login, and the shared secret for script access to
# /api/admin/* — generate with `openssl rand -base64 24`. Changing it signs out
# every open admin session.
ADMIN_SECRET=
